+        victims = [path for step, path in found if path not in protected]
+        quota = max(0, keep_latest - len(protected))
+        stale = victims if quota == 0 else victims[: max(0, len(victims) - quota)]
+        for path in stale:
+            print(f"Removing old checkpoint (keep {keep_latest}): {path}")
+            shutil.rmtree(path, ignore_errors=True)
