+
+        found = []
+        for name in os.listdir(ckpt_root):
+            if not name.startswith("global_step_"):
+                continue
+            suffix = name[len("global_step_") :]
+            if not suffix.isdigit():
+                continue
+            found.append((int(suffix), os.path.join(ckpt_root, name)))
+        found.sort()
