+    def _validation_plateau_score(self, val_metrics: dict) -> Optional[float]:
+        """Average the val-core mean reward/accuracy across data sources."""
+        values = []
+        for key, value in val_metrics.items():
+            key = str(key)
+            if not key.startswith("val-core/"):
+                continue
+            if "/reward/" not in key and "/acc/" not in key:
+                continue
+            if "/mean@" not in key and not key.endswith("/mean"):
+                continue
+            try:
+                values.append(float(value))
+            except (TypeError, ValueError):
+                continue
+        if not values:
+            return None
+        return sum(values) / len(values)
+
+    def _note_validation_for_early_stop(self, val_metrics: dict) -> bool:
+        """Return True when recent validations have stopped improving.
+
+        The first call records the baseline. Later calls count a stall when the
+        score does not beat the best by ``early_stop_min_delta``. Training stops
+        after ``early_stop_patience`` stalls in a row. Patience 0 disables this.
+        """
+        patience = int(self.config.trainer.get("early_stop_patience", 0) or 0)
+        min_delta = float(self.config.trainer.get("early_stop_min_delta", 0.01) or 0.0)
+        score = self._validation_plateau_score(val_metrics)
+        if score is None:
+            print("Early stop skipped: no val-core mean reward/acc in validation metrics.")
+            return False
+        val_metrics["val/plateau_score"] = score
+        if not hasattr(self, "_eval_best"):
+            self._eval_best = float("-inf")
+            self._eval_stall = 0
+        if score > self._eval_best + min_delta:
+            self._eval_best = score
+            self._eval_stall = 0
+            improved = True
+        else:
+            self._eval_stall += 1
+            improved = False
+        val_metrics["val/early_stop_stall"] = self._eval_stall
+        val_metrics["val/early_stop_best"] = self._eval_best
+        print(
+            f"Validation plateau score={score:.4f} best={self._eval_best:.4f} "
+            f"stall={self._eval_stall}/{patience} improved={improved}"
+        )
+        if patience > 0 and self._eval_stall >= patience:
+            print(
+                f"Validation stable for {patience} evals "
+                f"(delta <= {min_delta}). Stopping training."
+            )
+            return True
+        return False
+
