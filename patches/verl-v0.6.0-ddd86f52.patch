+    def _prune_local_checkpoints(self, keep_latest: int, protect_step: Optional[int] = None):
+        """Delete old ``global_step_*`` directories so at most ``keep_latest`` remain.
+
+        The actor manager only remembers paths saved in this process and only removes the
+        ``actor/`` subdirectory. ``data.pt`` and checkpoints from a previous process would
+        otherwise stay on disk. A 50GB data disk cannot hold two FSDP model shards, so old
+        copies are removed before the new one is written.
